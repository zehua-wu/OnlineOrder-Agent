# 推荐先用无密钥演示：LLM_PROVIDER=mock，DEMO_BACKEND=true。
# 接真实后端时必须 DEMO_BACKEND=false；API Key 只填本地 .env，禁止提交。
APP_ENV=development
LLM_PROVIDER=qwen
LLM_API_KEY=
# Qwen 中国区默认 qwen-plus；DeepSeek 使用 deepseek-chat。
# 留空自动按 provider 选择；也可替换成你账号开通的 tool-calling 模型。
LLM_MODEL=
LLM_BASE_URL=
# 可选：不使用 LLM_API_KEY 时，按 provider 读取对应 key。
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1200
DEMO_BACKEND=false
ONLINEORDER_BACKEND_URL=http://localhost:8080
BACKEND_TIMEOUT_SECONDS=5
BACKEND_READ_RETRIES=1
# memory 只适合单进程开发；生产配置会强制要求 redis。
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=14400
SESSION_RECENT_MESSAGE_LIMIT=12
LONG_TERM_MEMORY_LIMIT=50
MEMORY_EXTRACTION_ENABLED=true
MEMORY_TIMEOUT_SECONDS=5
AGENT_MAX_TOOL_STEPS=5
AGENT_TURN_TIMEOUT_SECONDS=75
CONTEXT_CHAR_BUDGET=30000
PENDING_ACTION_TTL_SECONDS=300
RESULT_REFERENCE_TTL_SECONDS=900
# 幂等日志默认 7 天，必须不小于 Session TTL。
ACTION_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3000
